# Copiar a .env y rellenar. El .env NUNCA se sube a git.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=qhcube_db

# Usuario de la aplicación en MySQL (lo usa Spring)
DB_USER=
DB_PASSWORD=

# Contraseña de la cuenta de correo del proyecto (envío de emails de validación)
MAIL_PASSWORD=

# Secreto para firmar los tokens JWT
JWT_SECRET=
